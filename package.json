{
  "name": "raven-overlay",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/index.js",
  "description": "A local, read-only AI development overlay helper.",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.raven.overlay",
    "productName": "Raven",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "win": { "target": "portable", "artifactName": "Raven-${version}-Portable.${ext}", "signAndEditExecutable": false }
  }
}
